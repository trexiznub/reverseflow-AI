{
  "xsappname": "reverseflow",
  "tenant-mode": "dedicated",
  "description": "ReverseFlow returns control tower: roles and approval rights",
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Administrator: run SAP connection tests, reset the demo, present other personas"
    },
    {
      "name": "$XSAPPNAME.OpsManager",
      "description": "Operations Manager: approve logistics and routing, send SAP messages"
    },
    {
      "name": "$XSAPPNAME.VendorQuality",
      "description": "Seller Quality Manager: approve seller quality actions"
    },
    {
      "name": "$XSAPPNAME.WarehouseManager",
      "description": "Warehouse Manager: approve inspection and resale actions"
    },
    {
      "name": "$XSAPPNAME.DisputeReviewer",
      "description": "Customer Policy: return-policy changes and checks on flagged returns"
    },
    {
      "name": "$XSAPPNAME.Vendor",
      "description": "Seller partner portal"
    },
    {
      "name": "$XSAPPNAME.Logistics",
      "description": "Delivery partner portal"
    },
    {
      "name": "$XSAPPNAME.WarehousePartner",
      "description": "Inspection team portal"
    },
    {
      "name": "$XSAPPNAME.Customer",
      "description": "Customer returns app"
    }
  ],
  "attributes": [
    {
      "name": "scope_id",
      "description": "Seller, carrier or warehouse the person belongs to",
      "valueType": "string",
      "valueRequired": false
    }
  ],
  "role-templates": [
    {
      "name": "Admin",
      "description": "ReverseFlow administrator",
      "scope-references": [
        "$XSAPPNAME.Admin",
        "$XSAPPNAME.OpsManager"
      ]
    },
    {
      "name": "OpsManager",
      "description": "Operations Manager",
      "scope-references": [
        "$XSAPPNAME.OpsManager"
      ]
    },
    {
      "name": "VendorQuality",
      "description": "Seller Quality Manager",
      "scope-references": [
        "$XSAPPNAME.VendorQuality"
      ]
    },
    {
      "name": "WarehouseManager",
      "description": "Warehouse Manager",
      "scope-references": [
        "$XSAPPNAME.WarehouseManager"
      ]
    },
    {
      "name": "DisputeReviewer",
      "description": "Customer Policy",
      "scope-references": [
        "$XSAPPNAME.DisputeReviewer"
      ]
    },
    {
      "name": "Vendor",
      "description": "Seller",
      "scope-references": [
        "$XSAPPNAME.Vendor"
      ],
      "attribute-references": [
        "scope_id"
      ]
    },
    {
      "name": "Logistics",
      "description": "Delivery partner",
      "scope-references": [
        "$XSAPPNAME.Logistics"
      ],
      "attribute-references": [
        "scope_id"
      ]
    },
    {
      "name": "WarehousePartner",
      "description": "Inspection team",
      "scope-references": [
        "$XSAPPNAME.WarehousePartner"
      ],
      "attribute-references": [
        "scope_id"
      ]
    },
    {
      "name": "Customer",
      "description": "Customer",
      "scope-references": [
        "$XSAPPNAME.Customer"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "ReverseFlow_Admin",
      "description": "ReverseFlow administrator",
      "role-template-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "ReverseFlow_OpsManager",
      "description": "ReverseFlow Operations Manager",
      "role-template-references": [
        "$XSAPPNAME.OpsManager"
      ]
    },
    {
      "name": "ReverseFlow_VendorQuality",
      "description": "ReverseFlow Seller Quality Manager",
      "role-template-references": [
        "$XSAPPNAME.VendorQuality"
      ]
    },
    {
      "name": "ReverseFlow_WarehouseManager",
      "description": "ReverseFlow Warehouse Manager",
      "role-template-references": [
        "$XSAPPNAME.WarehouseManager"
      ]
    },
    {
      "name": "ReverseFlow_DisputeReviewer",
      "description": "ReverseFlow Customer Policy",
      "role-template-references": [
        "$XSAPPNAME.DisputeReviewer"
      ]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.hana.ondemand.com/**",
      "https://*.applicationstudio.cloud.sap/**"
    ]
  }
}
