# SQLAlchemy database URL. Default: SQLite file in backend/data/
# DATABASE_URL=sqlite:///./data/reverseflow.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/reverseflow
# SAP HANA Cloud:
# DATABASE_URL=hana://USER:PASSWORD@HOST.hanacloud.ondemand.com:443?encrypt=true

# Frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: OpenAI-compatible endpoint used only to phrase explanations.
# Leave unset to use the offline evidence templates (default, no paid API).
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# Optional: SAP Generative AI Hub (values from an SAP AI Core service key)
# AICORE_AUTH_URL=https://<subdomain>.authentication.eu10.hana.ondemand.com
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_BASE_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com
# AICORE_DEPLOYMENT_ID=
# AICORE_RESOURCE_GROUP=default

# Optional: where messages for SAP systems are sent (usually SAP Integration Suite flows)
# SAP_IBP_URL=
# SAP_TM_URL=
# SAP_ARIBA_URL=
# SAP_TM_TOKEN_URL=   SAP_TM_CLIENT_ID=   SAP_TM_CLIENT_SECRET=   (OAuth; same pattern for IBP and ARIBA)

# Try sending without an SAP tenant: a local test receiver
# REVERSEFLOW_SAP_SANDBOX=1
# SAP_TM_URL=http://localhost:8040/api/sap/sandbox/tm
