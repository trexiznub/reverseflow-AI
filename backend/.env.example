# SQLAlchemy database URL. Default: SQLite file in backend/data/
# DATABASE_URL=sqlite:///./data/reverseflow.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/reverseflow

# Frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: OpenAI-compatible endpoint used only to phrase explanations.
# Leave unset to use the offline evidence templates (default, no paid API).
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
