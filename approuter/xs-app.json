{
  "welcomeFile": "/",
  "authenticationMethod": "route",
  "logout": { "logoutEndpoint": "/do/logout", "logoutPage": "/" },
  "routes": [
    { "source": "^/api/health$", "target": "/api/health", "destination": "srv-api", "authenticationType": "none" },
    { "source": "^/api/(.*)$", "target": "/api/$1", "destination": "srv-api", "authenticationType": "xsuaa", "csrfProtection": false },
    { "source": "^/(.*)$", "target": "/$1", "destination": "web", "authenticationType": "xsuaa" }
  ]
}
